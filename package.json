{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node scripts/gen-og-image.mjs && node scripts/gen-sitemap.mjs && vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "test": "vitest",
    "test:smoke": "vitest --run src/components/ProtectedRoute.smoke.test.tsx src/components/TutorChat.smoke.test.tsx src/components/MaterialsFactory.smoke.test.tsx src/lib/export.smoke.test.ts src/hooks/useTaskFilters.test.ts src/components/ExtractionEngine.smoke.test.tsx src/components/SmartGrader.smoke.test.tsx src/components/AnalyticsDashboard.smoke.test.tsx src/components/MathRenderer.smoke.test.tsx src/lib/mathVerify.test.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "postinstall": "node scripts/fix-vitest-runner.cjs",
    "quality:bundle": "node scripts/check-bundle-budget.mjs",
    "quality:routes": "node scripts/check-route-budgets.mjs",
    "quality:ingestion": "vitest run src/lib/ingestion/sanitize.test.ts src/lib/ingestion/injectionScan.test.ts src/lib/ingestion/preflight.test.ts src/lib/ingestion/policy.test.ts src/lib/ingestion/diagnostics.test.ts src/lib/ingestion/metadata.test.ts src/lib/ingestion/config.test.ts",
    "quality:governance": "node scripts/check-governance.mjs",
    "quality:gates": "node scripts/run-quality-gates.mjs",
    "migrate:dry": "node scripts/migrate-from-ai-studio.mjs --dry-run",
    "migrate": "node scripts/migrate-from-ai-studio.mjs",
    "backup": "node scripts/backup-firestore.mjs",
    "backup:old": "node scripts/backup-firestore.mjs --old",
    "promote": "node scripts/promote-to-production.mjs"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "^0.76.0",
    "@google/genai": "^1.50.1",
    "@sentry/react": "^10.56.0",
    "@stripe/stripe-js": "^9.3.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.100.4",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/d3": "^7.4.3",
    "@types/react-window": "^2.0.0",
    "canvas-confetti": "^1.9.4",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "docx": "^9.6.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "firebase": "^12.12.1",
    "framer-motion": "^12.42.2",
    "fuse.js": "^7.3.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.2.1",
    "jsxgraph": "^1.12.2",
    "katex": "^0.16.45",
    "konva": "^10.2.5",
    "lucide-react": "^1.11.0",
    "mammoth": "^1.12.0",
    "mathlive": "^0.109.2",
    "motion": "^12.38.0",
    "motion-dom": "^12.42.2",
    "pdfjs-dist": "^5.6.205",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-firebase-hooks": "^5.1.1",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.10",
    "react-image-crop": "^11.0.10",
    "react-is": "^19.2.7",
    "react-konva": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.2",
    "react-to-print": "^3.3.0",
    "react-window": "^2.2.7",
    "recharts": "^3.8.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "youtube-transcript": "^1.3.1",
    "zustand": "^5.0.12"
