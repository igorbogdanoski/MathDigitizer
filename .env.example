# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Comma-separated CORS allowlist for API and Socket.IO origins.
# Example: ALLOWED_ORIGINS="https://mathdigitizer.app,https://www.mathdigitizer.app"
ALLOWED_ORIGINS=""

# Keep disabled by default. Enable only if frontend must fetch /api/config.
ALLOW_PUBLIC_API_CONFIG="false"

# -----------------------------
# SaaS / Pricing Configuration
# -----------------------------

# Public pricing (MKD)
VITE_PRO_MONTHLY_PRICE_MKD="490"
VITE_PRO_ANNUAL_PRICE_MKD="4900"

# Checkout links (optional, per channel)
# If a link is not set, UI will fallback to manual payment details.
VITE_STRIPE_PAYMENT_LINK=""
VITE_PAYPAL_PAYMENT_LINK=""
VITE_BANK_TRANSFER_PAYMENT_LINK=""

# Manual payment details shown in Pricing page
VITE_PAYPAL_EMAIL="igor.bogdanoski@mismath.net"
VITE_BILLING_CONTACT_EMAIL="igor.bogdanoski@mismath.net"
VITE_BANK_NAME="NLB Bank"
VITE_BANK_ACCOUNT_NUMBER="210501596102457"
VITE_BANK_IBAN="MK07210501596102457"
VITE_BANK_SWIFT="TUTNMK22"
VITE_SCHOOL_PLAN_LABEL="По договор / фактура"

# Sales ops alerts for School Inquiries Dashboard
# Trigger warning when pending receipts >= this threshold.
VITE_PENDING_ALERT_THRESHOLD="8"
# Trigger warning when (pending / max(approved, 1)) exceeds this ratio.
VITE_PENDING_TO_APPROVED_RATIO_ALERT_THRESHOLD="1"
# Trigger warning when 7-day billing CTA conversion (clicks/pending) falls below this value.
VITE_BILLING_CTA_CONVERSION_ALERT_THRESHOLD="0.8"
# Trigger critical alert when 7-day billing CTA conversion falls below this value.
VITE_BILLING_CTA_CONVERSION_CRITICAL_THRESHOLD="0.5"

# EmailJS — transactional emails (receipt submitted, pro activated)
VITE_EMAILJS_SERVICE_ID="service_8g6e93j"
VITE_EMAILJS_TEMPLATE_ADMIN="template_vxz3i86"
VITE_EMAILJS_TEMPLATE_TEACHER="template_2lhshwl"
VITE_EMAILJS_PUBLIC_KEY="jztgJpC8Sc0bm16CG"
VITE_ADMIN_EMAIL="bogdanoskiigor@gmail.com"

# Security hardening: keep false by default.
# When true, jsxgraph scripts from markdown can execute only after strict token screening,
# and the runtime library is loaded from trusted CDN at runtime (not bundled locally).
VITE_ENABLE_UNSAFE_JSXGRAPH_SCRIPT="false"
